{
  "name": "@recoillink/cli",
  "version": "45.0.1",
  "description": "A command-line utility for common Recoil Link operations",
  "keywords": [
    "CLI",
    "Deployment",
    "Hyperlane",
    "Permissionless",
    "Typescript"
  ],
  "homepage": "https://github.com/recoil-labs/recoil-link",
  "license": "Apache-2.0",
  "repository": "https://github.com/recoil-labs/recoil-link",
  "bin": {
    "rlink": "./bundle/index.js"
  },
  "files": [
    "./bundle",
    "./examples",
    "package.json"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "rlink": "node ./dist/cli.js",
    "build": "pnpm version:update && NODE_OPTIONS='--max-old-space-size=4096' tsc",
    "check": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit",
    "bundle": "rm -rf ./bundle && ncc build ./dist/cli.js -o bundle && node ../../scripts/ncc.post-bundle.mjs",
    "dev": "pnpm version:update && tsc --watch",
    "clean": "rm -rf ./dist && rm -rf ./bundle",
    "lint": "oxlint -c ../../oxlint.json",
    "format": "oxfmt --write ./src ./examples",
    "test:ci": "mocha --config .mocharc.json",
    "test:ethereum:e2e": "./src/tests/ethereum/run-e2e-test.sh",
    "test:cross-chain:e2e": "./src/tests/cross-chain/run-e2e-test.sh",
    "test:cosmosnative:e2e": "./src/tests/cosmosnative/run-e2e-test.sh",
    "test:radix:e2e": "./src/tests/radix/run-e2e-test.sh",
    "test:aleo:e2e": "./src/tests/aleo/run-e2e-test.sh",
    "test:sealevel:e2e": "./src/tests/sealevel/run-e2e-test.sh",
    "test:starknet:e2e": "./src/tests/starknet/run-e2e-test.sh",
    "test:tron:e2e": "./src/tests/ethereum/run-tron-e2e-test.sh",
    "version:update": "echo \"export const VERSION = '$npm_package_version';\" > src/version.ts",
    "prepack": "pnpm bundle"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@cosmjs/proto-signing": "catalog:",
    "@cosmjs/stargate": "catalog:",
    "@ethersproject/abi": "*",
    "@ethersproject/constants": "*",
    "@ethersproject/providers": "*",
    "@recoillink/aleo-sdk": "workspace:*",
    "@recoillink/core": "workspace:*",
    "@recoillink/cosmos-sdk": "workspace:*",
    "@recoillink/deploy-sdk": "workspace:*",
    "@recoillink/forking-sdk": "workspace:*",
    "@recoillink/http-registry-server": "workspace:*",
    "@recoillink/provider-sdk": "workspace:*",
    "@recoillink/radix-sdk": "workspace:*",
    "@recoillink/rebalancer": "workspace:*",
    "@hyperlane-xyz/registry": "catalog:",
    "@recoillink/relayer": "workspace:*",
    "@recoillink/sdk": "workspace:*",
    "@recoillink/sealevel-sdk": "workspace:*",
    "@recoillink/starknet-sdk": "workspace:*",
    "@recoillink/tron-sdk": "workspace:*",
    "@recoillink/tsconfig": "workspace:^",
    "@recoillink/utils": "workspace:*",
    "@inquirer/core": "9.0.10",
    "@inquirer/figures": "1.0.5",
    "@inquirer/prompts": "catalog:",
    "@inquirer/search": "^3.0.1",
    "@inquirer/select": "catalog:",
    "@inquirer/type": "^1.0.0",
    "@solana/kit": "catalog:",
    "@solana/spl-token": "catalog:",
    "@solana/web3.js": "catalog:",
    "@types/chai": "catalog:",
    "@types/chai-as-promised": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "@types/yargs": "catalog:",
    "@vercel/ncc": "catalog:",
    "ansi-escapes": "^7.0.0",
    "asn1.js": "catalog:",
    "bignumber.js": "catalog:",
    "chai": "catalog:",
    "chai-as-promised": "catalog:",
    "chalk": "catalog:",
    "ethers": "catalog:",
    "execa": "^9.5.3",
    "latest-version": "^8.0.0",
    "lodash-es": "catalog:",
    "mocha": "catalog:",
    "oxfmt": "catalog:",
    "pino": "catalog:",
    "prom-client": "catalog:",
    "sinon": "catalog:",
    "terminal-link": "^3.0.0",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "yaml": "catalog:",
    "yargs": "catalog:",
    "zksync-ethers": "catalog:",
    "zod": "catalog:",
    "zx": "^8.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
