{
  "name": "@recoillink/starknet-sdk",
  "version": "30.0.4",
  "description": "Recoil Link TypeScript SDK for Starknet artifact API support",
  "keywords": [
    "blockchain",
    "hyperlane",
    "sdk",
    "starknet"
  ],
  "homepage": "https://github.com/recoil-labs/recoil-link",
  "license": "Apache-2.0",
  "repository": "https://github.com/recoil-labs/recoil-link",
  "files": [
    "/dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "format": "oxfmt --write ./src",
    "lint": "oxlint -c ../../oxlint.json",
    "clean": "rm -rf ./dist ./cache",
    "dev": "tsc --watch",
    "test": "mocha --config .mocharc.json",
    "test:e2e": "./scripts/run-e2e-test.sh",
    "test:ci": "pnpm test"
  },
  "dependencies": {
    "@recoillink/provider-sdk": "workspace:*",
    "@recoillink/starknet-core": "workspace:*",
    "@recoillink/utils": "workspace:*",
    "starknet": "catalog:"
  },
  "devDependencies": {
    "@recoillink/tsconfig": "workspace:^",
    "@types/chai": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "chai": "catalog:",
    "mocha": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
