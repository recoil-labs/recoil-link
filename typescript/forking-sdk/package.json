{
  "name": "@recoillink/forking-sdk",
  "version": "10.0.3-recoil.1",
  "description": "VM-agnostic local forking abstraction for Recoil Link",
  "license": "Apache-2.0",
  "repository": "https://github.com/recoil-labs/recoil-link",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "oxlint -c ../../oxlint.json",
    "clean": "rm -rf ./dist",
    "format": "oxfmt --write .",
    "test": "mocha --config .mocharc.json",
    "test:ci": "mocha --config .mocharc.json"
  },
  "dependencies": {
    "@recoillink/provider-sdk": "workspace:*",
    "@recoillink/utils": "workspace:*"
  },
  "devDependencies": {
    "@recoillink/tsconfig": "workspace:^",
    "@types/chai": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "chai": "catalog:",
    "mocha": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
