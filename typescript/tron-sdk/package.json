{
  "name": "@recoillink/tron-sdk",
  "version": "26.0.1",
  "description": "Recoil Link TypeScript SDK for Tron",
  "keywords": [
    "blockchain",
    "hyperlane",
    "sdk",
    "tron"
  ],
  "homepage": "https://github.com/recoil-labs/recoil-link",
  "license": "Apache-2.0",
  "repository": "https://github.com/recoil-labs/recoil-link",
  "files": [
    "/dist",
    "local-node"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "format": "oxfmt --write src/**/*.ts",
    "lint": "oxlint -c ../../oxlint.json",
    "clean": "rm -rf ./dist ./cache ./coverage",
    "dev": "tsc --watch",
    "test": "mocha --config .mocharc.json './src/**/*.test.ts'",
    "coverage": "c8 pnpm test"
  },
  "dependencies": {
    "@ethersproject/abi": "*",
    "@ethersproject/providers": "*",
    "@recoillink/core": "workspace:*",
    "@recoillink/provider-sdk": "workspace:*",
    "@hyperlane-xyz/registry": "catalog:",
    "@recoillink/utils": "workspace:*",
    "bignumber.js": "catalog:",
    "ethers": "catalog:",
    "tronweb": "catalog:"
  },
  "devDependencies": {
    "@recoillink/tsconfig": "workspace:^",
    "@types/chai": "catalog:",
    "@types/chai-as-promised": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/unzipper": "^0",
    "c8": "catalog:",
    "chai": "catalog:",
    "chai-as-promised": "catalog:",
    "mocha": "catalog:",
    "mocha-steps": "catalog:",
    "node-fetch": "^3.3.2",
    "testcontainers": "catalog:",
    "ts-node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
