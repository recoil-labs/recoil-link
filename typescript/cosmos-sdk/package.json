{
  "name": "@recoillink/cosmos-sdk",
  "version": "45.1.1-recoil.1",
  "description": "Recoil Link TypeScript SDK for Cosmos",
  "keywords": [
    "blockchain",
    "cosmos",
    "recoil-link",
    "sdk"
  ],
  "homepage": "https://github.com/recoil-labs/recoil-link",
  "license": "Apache-2.0",
  "repository": "https://github.com/recoil-labs/recoil-link",
  "files": [
    "/dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "format": "oxfmt --write ./src",
    "lint": "oxlint -c ../../oxlint.json",
    "clean": "rm -rf ./dist ./cache",
    "dev": "tsc --watch",
    "test": "pnpm test:unit",
    "test:ci": "pnpm test:unit",
    "test:unit": "mocha --require tsx --timeout 10000 'src/**/*.unit-test.ts'",
    "test:e2e": "mocha --config .mocharc-e2e.json"
  },
  "dependencies": {
    "@cosmjs/amino": "catalog:",
    "@cosmjs/math": "catalog:",
    "@cosmjs/proto-signing": "catalog:",
    "@cosmjs/stargate": "catalog:",
    "@cosmjs/tendermint-rpc": "catalog:",
    "@recoillink/cosmos-types": "workspace:*",
    "@recoillink/provider-sdk": "workspace:*",
    "@recoillink/utils": "workspace:*"
  },
  "devDependencies": {
    "@recoillink/tsconfig": "workspace:^",
    "@types/chai": "catalog:",
    "@types/chai-as-promised": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "chai": "catalog:",
    "chai-as-promised": "catalog:",
    "mocha": "catalog:",
    "mocha-steps": "catalog:",
    "oxfmt": "catalog:",
    "testcontainers": "catalog:",
    "ts-node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
