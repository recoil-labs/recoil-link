{
  "name": "@recoillink/radix-sdk",
  "version": "45.1.0",
  "description": "Recoil Link TypeScript SDK for Radix",
  "keywords": [
    "blockchain",
    "radix",
    "recoil-link",
    "sdk"
  ],
  "homepage": "https://github.com/recoil-labs/recoil-link",
  "license": "Apache-2.0",
  "repository": "https://github.com/recoil-labs/recoil-link",
  "files": [
    "/dist",
    "docker-compose.yml"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "format": "oxfmt --write ./src",
    "lint": "oxlint -c ../../oxlint.json",
    "clean": "rm -rf ./dist ./cache",
    "dev": "tsc --watch",
    "test": "echo \"no tests in radix-sdk\"",
    "test:unit": "mocha --config .mocharc.json",
    "test:ci": "pnpm test:unit",
    "test:e2e": "mocha --config .mocharc.e2e.json"
  },
  "dependencies": {
    "@radixdlt/babylon-core-api-sdk": "^1.3.0",
    "@radixdlt/babylon-gateway-api-sdk": "catalog:",
    "@radixdlt/radix-engine-toolkit": "^1.0.5",
    "@recoillink/provider-sdk": "workspace:*",
    "@recoillink/utils": "workspace:*",
    "bignumber.js": "catalog:",
    "decimal.js": "^10.4.3",
    "ethers": "catalog:"
  },
  "devDependencies": {
    "@recoillink/tsconfig": "workspace:^",
    "@types/chai": "catalog:",
    "@types/chai-as-promised": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "chai": "catalog:",
    "chai-as-promised": "catalog:",
    "mocha": "catalog:",
    "mocha-steps": "catalog:",
    "oxfmt": "catalog:",
    "testcontainers": "catalog:",
    "ts-node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
