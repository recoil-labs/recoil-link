{
  "name": "@recoillink/deploy-sdk",
  "version": "11.0.2",
  "description": "Deployer SDK for Recoil Link",
  "license": "Apache-2.0",
  "repository": "https://github.com/recoil-labs/recoil-link",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./AltVMFileSubmitter": "./dist/AltVMFileSubmitter.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "oxlint -c ../../oxlint.json",
    "clean": "rm -rf ./dist",
    "format": "oxfmt --write .",
    "test": "mocha --config .mocharc.json './src/**/*.test.ts' --exit"
  },
  "dependencies": {
    "@recoillink/aleo-sdk": "workspace:*",
    "@recoillink/cosmos-sdk": "workspace:*",
    "@recoillink/provider-sdk": "workspace:*",
    "@recoillink/radix-sdk": "workspace:*",
    "@recoillink/sealevel-sdk": "workspace:*",
    "@recoillink/starknet-sdk": "workspace:*",
    "@recoillink/tron-sdk": "workspace:*",
    "@recoillink/utils": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@recoillink/tsconfig": "workspace:^",
    "@types/chai": "catalog:",
    "@types/chai-as-promised": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/sinon": "catalog:",
    "@types/sinon-chai": "catalog:",
    "chai": "catalog:",
    "chai-as-promised": "catalog:",
    "mocha": "catalog:",
    "sinon": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
