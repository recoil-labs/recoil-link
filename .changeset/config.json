{
  "$schema": "https://unpkg.com/@changesets/config@2.3.1/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": true,
  "fixed": [
    [
      "@recoillink/aleo-sdk",
      "@recoillink/starknet-core",
      "@recoillink/ccip-server",
      "@recoillink/cli",
      "@recoillink/cosmos-sdk",
      "@recoillink/cosmos-types",
      "@recoillink/github-proxy",
      "@recoillink/helloworld",
      "@recoillink/http-registry-server",
      "@recoillink/infra",
      "@recoillink/radix-sdk",
      "@recoillink/sealevel-sdk",
      "@recoillink/sdk",
      "@recoillink/tsconfig",
      "@recoillink/utils",
      "@recoillink/widgets"
    ]
  ],
  "linked": [
    [
      "@recoillink/deploy-sdk",
      "@recoillink/provider-sdk"
    ]
  ],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [],
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}.{commit}"
  }
